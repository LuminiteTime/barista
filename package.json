{
  "name": "barista",
  "version": "0.1.0",
  "description": "Bind Claude Code sessions to Telegram chats and forum topics.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "barista": "dist/src/cli/main.js"
  },
  "files": [
    "dist",
    "mod",
    ".claude-plugin"
  ],
  "scripts": {
    "barista": "node src/cli/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=dot \"test/**/*.test.ts\"",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "check:mod": "claude plugin validate mod && claude plugin test mod && tsc -p mod"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
